#!/usr/bin/env bash
set -euo pipefail

docker_repository="claude-code"
context="$(dirname "$(realpath "$0")")/../"

# Fetch the latest version from npm registry API
echo "Fetching latest version of @anthropic-ai/claude-code from npm registry..."
version=$(curl -s https://registry.npmjs.org/@anthropic-ai/claude-code/latest | grep -o '"version":"[^"]*"' | cut -d'"' -f4)
echo "Latest version: ${version}"

docker build "$context" \
  --build-arg VERSION="${version}" \
  -t "${docker_repository}:${version}"
docker tag "${docker_repository}:${version}" "${docker_repository}:latest"

echo "Successfully built ${docker_repository}:${version} and tagged as ${docker_repository}:latest"
