#!/usr/bin/env bash
set -euo pipefail

# --- user configuration --------------------------------------------------
# All user settings live in a single file that is sourced as bash. Copy
# config.example to the path below and edit it. Override the location with
# CLAUDE_DOCKER_CONFIG.
#
# Settings you can override (defaults shown here):
#   IMAGE="my-claude-code"                    # image that `make build` produces
#   doc_mounts=(                              # always-on read-only mounts,
#     "${HOME}/git/my-docs:/docs/my-docs"     #   as "host:container" pairs
#   )
#   extra_docker_args=( --network host )      # appended verbatim to `docker run`
IMAGE="my-claude-code"
doc_mounts=()
extra_docker_args=()

CLAUDE_DOCKER_CONFIG="${CLAUDE_DOCKER_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/claude-docker.conf}"
if [[ -f "${CLAUDE_DOCKER_CONFIG}" ]]; then
  # shellcheck source=/dev/null
  source "${CLAUDE_DOCKER_CONFIG}"
fi
# -------------------------------------------------------------------------

host_path="$(realpath "$(pwd)")"

# Parse our own flags (--ro-mount / -R DIR, repeatable) and pass the rest to claude.
# Each DIR is mounted read-only under /mnt/ro/<basename> inside the container.
ro_mounts=()
claude_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -R|--ro-mount)
      if [[ $# -lt 2 ]]; then
        echo "Error: $1 requires a directory argument" >&2
        exit 1
      fi
      ro_mounts+=("$2")
      shift 2
      ;;
    --ro-mount=*)
      ro_mounts+=("${1#*=}")
      shift
      ;;
    --)
      shift
      claude_args+=("$@")
      break
      ;;
    *)
      claude_args+=("$1")
      shift
      ;;
  esac
done

# Prevent mounting system directories
case "${host_path}" in
  /|/bin|/sbin|/usr|/usr/*|/etc|/etc/*|/lib|/lib/*|/lib64|/lib64/*|/sys|/sys/*|/proc|/proc/*|/dev|/dev/*|/boot|/boot/*|/root|/root/*)
    echo "Error: Cannot run from system directory: ${host_path}" >&2
    echo "Run from a user directory like /home, /mnt, or /tmp" >&2
    exit 1
    ;;
esac

# Always-on documentation mounts (read-only) from the config file's doc_mounts.
doc_args=()
for pair in ${doc_mounts[@]+"${doc_mounts[@]}"}; do
  src="${pair%%:*}"
  if [[ -d "${src}" ]]; then
    doc_args+=(-v "${pair}:ro")
  else
    echo "Warning: documentation source not found, skipping: ${src}" >&2
  fi
done

# Extra read-only mounts requested on the command line via -R/--ro-mount.
# Each host directory is exposed at /mnt/ro/<basename> inside the container.
for src in ${ro_mounts[@]+"${ro_mounts[@]}"}; do
  abs="$(realpath "${src}")"
  if [[ -d "${abs}" ]]; then
    doc_args+=(-v "${abs}:/mnt/ro/$(basename "${abs}"):ro")
  else
    echo "Warning: read-only mount source not found, skipping: ${src}" >&2
  fi
done

exec docker run \
  --rm \
  -it \
  --user "$(id -u):$(id -g)" \
  -v "${HOME}/.claude:${HOME}/.claude" \
  -v "${HOME}/.claude.json:${HOME}/.claude.json" \
  -v "${HOME}/.claude.json.backup:${HOME}/.claude.json.backup" \
  -v "${host_path}:${host_path}" \
  ${doc_args[@]+"${doc_args[@]}"} \
  ${extra_docker_args[@]+"${extra_docker_args[@]}"} \
  -w "${host_path}" \
  -e HOME="${HOME}" \
  "${IMAGE}" ${claude_args[@]+"${claude_args[@]}"}
